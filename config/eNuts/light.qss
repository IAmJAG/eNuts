/* Light theme */

QMainWindow {
    background-color: #f5f5f5;
}

QFrame#BOTTOM_BAR {
    background-color: #ffffff;
    border-top: 2px solid #d0d0d0;
}

QFrame#SIDE_BAR {
    background-color: #ffffff;
    border-right: 2px solid #d0d0d0;
}

QPushButton {
    background-color: #ffffff;
    color: #303030;
    border: 1px solid #c8c8c8;
    padding: 6px 15px;
    border-radius: 0px;
    font-size: 12px;
    font-family: "Segoe UI", "Arial", sans-serif;
}

QPushButton:hover {
    background-color: #e9eef5;
    color: #111111;
}

QPushButton:pressed {
    background-color: #d6e4f5;
}

QPushButton:checked {
    background-color: #1976d2;
    color: #ffffff;
    border: 1px solid #1565c0;
    font-weight: bold;
}

QPushButton:checked:hover {
    background-color: #1565c0;
}

QPushButton#BTN_CLOSE:pressed {
    background-color: #d32f2f;
    color: white;
    border: 1px solid #d32f2f;
}

QPushButton#BTN_MENU {
    background-color: #ffffff;
    color: #1565c0;
    border: 1px solid #c8c8c8;
    padding: 6px 15px;
    border-radius: 0px;
    font-size: 12px;
    font-family: "Segoe UI", "Arial", sans-serif;
    text-align: left;
    padding-left: 10px;
}

QPushButton#BTN_MENU:hover {
    background-color: #1976d2;
    color: white;
    border: 1px solid #1976d2;
}

QPushButton#BTN_MENU:pressed {
    background-color: #d32f2f;
    color: white;
    border: 1px solid #d32f2f;
}

QPushButton#BTN_MENU:checked {
    background-color: #1976d2;
    color: #ffffff;
    border: 1px solid #1565c0;
    font-weight: bold;
}

QDialog {
    background-color: #f5f5f5;
    color: #303030;
}

QDialog QPushButton {
    min-width: 80px;
}

QDialog QPushButton#BTN_OK {
    background-color: #1976d2;
    color: white;
    border: 1px solid #1976d2;
}

QDialog QPushButton#BTN_OK:hover {
    background-color: #1565c0;
}

QDialog QPushButton#BTN_OK:pressed {
    background-color: #0d47a1;
}

QDialog QPushButton#BTN_CANCEL {
    background-color: #ffffff;
    color: #303030;
    border: 1px solid #c8c8c8;
}

QDialog QPushButton#BTN_CANCEL:hover {
    background-color: #eeeeee;
    color: #111111;
}

QDialog QPushButton#BTN_CANCEL:pressed {
    background-color: #e0e0e0;
}

QDialog QLabel {
    color: #303030;
    font-size: 12px;
    padding: 0px 0px;
    margin: 0px 0px 0px 0px;
}

QLabel[isTitle="true"] {
    color: #1565c0;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 8px;
    padding-bottom: 2px;
}

QLabel[isHeader="true"] {
    color: #7b1fa2;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 8px;
    padding-bottom: 2px;
    qproperty-alignment: 'AlignCenter';
    border: 1px solid #c7c7c7;
}

QDialog QLineEdit {
    background-color: #ffffff;
    color: #303030;
    border: 1px solid #bdbdbd;
    padding: 6px 8px;
    border-radius: 0px;
    selection-background-color: #1976d2;
}

QDialog QLineEdit:focus {
    border: 1px solid #1976d2;
}

QDialog QLineEdit:hover {
    border: 1px solid #909090;
}

QDialog QComboBox {
    background-color: #ffffff;
    color: #303030;
    border: 1px solid #bdbdbd;
    padding: 6px 8px;
    border-radius: 0px;
    min-width: 100px;
}

QDialog QComboBox:hover {
    border: 1px solid #909090;
}

QDialog QComboBox:focus {
    border: 1px solid #1976d2;
}

QDialog QComboBox::drop-down {
    border: none;
    width: 20px;
}

QDialog QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #606060;
}

QDialog QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #303030;
    border: 1px solid #bdbdbd;
    selection-background-color: #1976d2;
    selection-color: #ffffff;
}

QDialog QRadioButton {
    color: #303030;
    spacing: 8px;
}

QDialog QRadioButton:hover {
    color: #1565c0;
}

QDialog QWidget#WD_MODE_SELECTION {
    border: 1px solid #bdbdbd;
    border-radius: 4px;
    background-color: #fafafa;
    margin: 0px 0px 4px 0px;
}

QDialog QWidget#WD_MODE_SELECTION QRadioButton {
    padding: 2px 2px;
}

/* ==========================================================================
   New SideBar components (jAGQt.widgets)
   ========================================================================== */

QWidget#SideBar {
    background-color: #ffffff;
    border-right: 2px solid #d0d0d0;
}

QWidget#SideBarHeader {
    background-color: #f8f8f8;
    border-bottom: 1px solid #d0d0d0;
}

QLabel#SideBarHeaderTitle {
    color: #303030;
    font-size: 13px;
    font-weight: 600;
}

QLabel#SideBarHeaderCollapse {
    color: #909090;
    font-size: 14px;
}

QLabel#SideBarHeaderCollapse:hover {
    color: #1565c0;
    background-color: #e9eef5;
    border-radius: 3px;
}

QWidget#SideBarItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    color: #303030;
}

QWidget#SideBarItem[hover="true"] {
    background-color: #e9eef5;
    color: #111111;
}

QWidget#SideBarItem[selected="true"] {
    background-color: #1976d2;
    color: #ffffff;
    border-color: #1565c0;
    font-weight: bold;
}

QWidget#SideBarItem[selected="true"][hover="true"] {
    background-color: #1565c0;
}

QLabel#SideBarText {
    color: inherit;
    background: transparent;
}

QLabel#SideBarIcon {
    background: transparent;
}

QFrame#SideBarSeparator {
    background: #d0d0d0;
    border: none;
    max-height: 1px;
}

QScrollArea#SideBarContent {
    background: transparent;
    border: none;
}

QWidget#SideBarContentContainer {
    background: transparent;
}
