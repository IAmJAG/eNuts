/* Live pipeline only — light */

QMainWindow,
QWidget {
    background-color: #f5f5f5;
    color: #303030;
}

QWidget#W_WORKSPACE {
    background-color: #f5f5f5;
    color: #303030;
}

QWidget#W_SIDEBAR {
    background-color: #eeeeee;
    color: #303030;
    border-right: 1px solid #d0d0d0;
}

QWidget#W_SIDEBAR[dockSide="right"] {
    border-right: 0px;
    border-left: 1px solid #d0d0d0;
}

QWidget#W_SIDEBAR QWidget#W_HEADER {
    background-color: #ffffff;
    border-bottom: 1px solid #d6d6d6;
    color: #202020;
}

QLabel#SideBarHeaderTitle,
QLabel#W_SIDEBAR_TITLE {
    color: #303030;
    background: transparent;
}

QScrollArea#W_CONTENT,
QWidget#W_CONTENT_BODY {
    background-color: #eeeeee;
}

QWidget#W_DOCK_CONTROL {
    background-color: #ffffff;
    border-top: 1px solid #d6d6d6;
}

QWidget#W_SIDEBAR_ITEM {
    background-color: transparent;
    color: #505050;
    border-left: 2px solid transparent;
}

QWidget#W_SIDEBAR_ITEM:hover,
QWidget#W_SIDEBAR_ITEM[hover="true"] {
    background-color: #e2e2e2;
    color: #202020;
}

QWidget#W_SIDEBAR_ITEM[active="true"] {
    background-color: #bbdefb;
    color: #202020;
    border-left: 2px solid #1976d2;
}

QWidget#W_SIDEBAR_ITEM[selected="true"] {
    background-color: #d6eaff;
    color: #202020;
    border-left: 2px solid #1976d2;
}

QWidget#W_SIDEBAR_GROUP_BODY {
    background-color: #f5f5f5;
}

QWidget#W_PAGE,
QWidget#DashboardPage,
QWidget#W_PAGE_CONTENT {
    background-color: #f5f5f5;
    color: #303030;
}

QWidget#W_PAGE_HEADER {
    background-color: #ffffff;
    border-bottom: 1px solid #d6d6d6;
    color: #303030;
}

QLabel#W_HEADER_TITLE {
    color: #202020;
}

QLabel#W_HEADER_DESCRIPTION {
    color: #606060;
}

QWidget#DashboardGrid {
    background-color: #f5f5f5;
}

QFrame#Card {
    background-color: #ffffff;
    color: #303030;
    border: 1px solid #d6d6d6;
}

QFrame#Card:hover {
    border-color: #1976d2;
}

QLabel#Card_Title {
    color: #202020;
}

QWidget#W_COMMANDBAR {
    background-color: #ffffff;
    border-top: 1px solid #d6d6d6;
}

QPushButton#C_COMMANDBAR_BUTTON {
    background-color: #ffffff;
    color: #303030;
    border: 1px solid #c8c8c8;
}
