/* Live pipeline only — dark */

QMainWindow,
QWidget {
    background-color: #181818;
    color: #d4d4d4;
}

QWidget#W_WORKSPACE {
    background-color: #181818;
    color: #d4d4d4;
}

QWidget#W_SIDEBAR {
    background-color: #151515;
    color: #d4d4d4;
    border-right: 1px solid #303030;
}

QWidget#W_SIDEBAR[dockSide="right"] {
    border-right: 0px;
    border-left: 1px solid #303030;
}

QWidget#W_SIDEBAR QWidget#W_HEADER {
    background-color: #1c1c1c;
    border-bottom: 1px solid #303030;
    color: #ffffff;
}

QLabel#SideBarHeaderTitle,
QLabel#W_SIDEBAR_TITLE {
    color: #d4d4d4;
    background: transparent;
}

QScrollArea#W_CONTENT,
QWidget#W_CONTENT_BODY {
    background-color: #151515;
}

QWidget#W_DOCK_CONTROL {
    background-color: #1c1c1c;
    border-top: 1px solid #303030;
}

QWidget#W_SIDEBAR_ITEM {
    background-color: transparent;
    color: #bdbdbd;
    border-left: 2px solid transparent;
}

QWidget#W_SIDEBAR_ITEM:hover,
QWidget#W_SIDEBAR_ITEM[hover="true"] {
    background-color: #252525;
    color: #ffffff;
}

QWidget#W_SIDEBAR_ITEM[active="true"] {
    background-color: #264f78;
    color: #ffffff;
    border-left: 2px solid #007acc;
}

QWidget#W_SIDEBAR_ITEM[selected="true"] {
    background-color: #303030;
    color: #ffffff;
    border-left: 2px solid #007acc;
}

QWidget#W_SIDEBAR_GROUP_BODY {
    background-color: #181818;
}

QWidget#W_PAGE,
QWidget#DashboardPage,
QWidget#W_PAGE_CONTENT {
    background-color: #181818;
    color: #d4d4d4;
}

QWidget#W_PAGE_HEADER {
    background-color: #202020;
    border-bottom: 1px solid #303030;
    color: #d4d4d4;
}

QLabel#W_HEADER_TITLE {
    color: #ffffff;
}

QLabel#W_HEADER_DESCRIPTION {
    color: #999999;
}

QWidget#DashboardGrid {
    background-color: #181818;
}

QFrame#Card {
    background-color: #1c1c1c;
    color: #d4d4d4;
    border: 1px solid #303030;
}

QFrame#Card:hover {
    border-color: #007acc;
}

QLabel#Card_Title {
    color: #ffffff;
}

QWidget#W_COMMANDBAR {
    background-color: #202020;
    border-top: 1px solid #303030;
}

QPushButton#C_COMMANDBAR_BUTTON {
    background-color: #252525;
    color: #d4d4d4;
    border: 1px solid #383838;
}
