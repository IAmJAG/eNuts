/* ==================================================================================
   CommandBar — structural (optional; used when Page commandBarOn=True)
   ================================================================================== */

QWidget#W_COMMANDBAR {
    min-height: 42px;
    max-height: 42px;
    padding: 0px 8px;
    border: 0px;
    border-top: 1px solid rgba(255, 255, 255, 18);
}

QWidget#W_COMMANDBAR > QWidget {
    background: transparent;
    border: 0px;
}

QPushButton#C_COMMANDBAR_BUTTON {
    min-height: 30px;
    max-height: 30px;
    min-width: 72px;
    padding: 0px 14px;
    margin: 6px 2px;
    border-radius: 0px;
    outline: none;
}
