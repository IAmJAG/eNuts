/* eNuts — dark theme */

QMainWindow,
QWidget {
    background: #181818;
    color: #d4d4d4;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
}

#SIDE_BAR {
    background: #202020;
    border-right: 1px solid #303030;
}

#BOTTOM_BAR {
    background: #202020;
    border-top: 1px solid #303030;
}

#SIDE_BAR QPushButton,
#BOTTOM_BAR QPushButton {
    background: transparent;
    color: #b8b8b8;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 7px 10px;
}

#SIDE_BAR QPushButton {
    text-align: left;
}

#BOTTOM_BAR QPushButton {
    background: #292929;
    border-color: #383838;
    color: #c8c8c8;
    padding: 5px 12px;
    text-align: center;
}

#SIDE_BAR QPushButton:hover,
#BOTTOM_BAR QPushButton:hover {
    background: #333333;
    color: #eeeeee;
    border-color: #484848;
}

#SIDE_BAR QPushButton:pressed,
#BOTTOM_BAR QPushButton:pressed {
    background: #303030;
}

#SIDE_BAR QPushButton:checked {
    background: #2d3945;
    color: #ffffff;
    border-color: #3d5368;
}

#SIDE_BAR QPushButton:checked:hover {
    background: #344554;
}

#SIDE_BAR QPushButton:disabled,
#BOTTOM_BAR QPushButton:disabled {
    color: #666666;
    background: transparent;
    border-color: transparent;
}

#BOTTOM_BAR QPushButton:pressed {
    background: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

QPushButton#CONTEXT_BACK { font-weight: 600; }
QPushButton#ADD_DEVICE { color: #75bdf5; }
QPushButton#ADD_DEVICE:hover { background: #263746; color: #ffffff; }

QListWidget { background: transparent; border: none; outline: none; padding: 4px 0; }
QListWidget::item { color: #b8b8b8; padding: 7px 10px; border-radius: 4px; }
QListWidget::item:hover { background: #2a2a2a; color: #eeeeee; }
QListWidget::item:selected { background: #2d3945; color: #ffffff; }

QLabel#PAGE_TITLE { color: #f0f0f0; font-size: 20px; font-weight: 600; }
QLabel#WORKSPACE_DESCRIPTION { color: #999999; }
QLabel#WORKSPACE_SECTION_TITLE { color: #d8d8d8; font-size: 14px; font-weight: 600; }

QFrame#TRAINING_STAT_CARD,
QFrame#TRAINING_DEVICE_CARD { background: #202020; border: 1px solid #303030; border-radius: 6px; }
QFrame#TRAINING_STAT_CARD:hover,
QFrame#TRAINING_DEVICE_CARD:hover { border-color: #3d5368; }

QLabel#TRAINING_STAT_VALUE { color: #f0f0f0; font-size: 22px; font-weight: 600; }
QLabel#TRAINING_STAT_LABEL { color: #888888; font-size: 10px; font-weight: 600; }
QLabel#TRAINING_DEVICE_NAME { color: #eeeeee; font-size: 14px; font-weight: 600; }
QLabel#TRAINING_DEVICE_KIND { color: #888888; }
QLabel#TRAINING_DEVICE_STATUS { color: #75bdf5; font-size: 11px; }

/* ==========================================================================
   SideBar hierarchy
   Level 0 – app header (chrome)
   Level 1 – group headers (section context — secondary)
   Level 2 – leaf items (active navigation — dominant)
   ========================================================================== */

QWidget#SideBar {
    background: #1a1a1a;
    border-right: 1px solid #2e2e2e;
}

/* ----- Level 0: Main header ------------------------------------------------ */
QWidget#SideBarHeader {
    background: #141414;
    border: none;
    border-bottom: 2px solid #3d5368;
    min-height: 44px;
    padding: 4px 0px;
}

QLabel#SideBarHeaderTitle {
    color: #f5f5f5;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

QLabel#SideBarHeaderCollapse {
    color: #7a8a9a;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    padding: 2px 4px;
}

QLabel#SideBarHeaderCollapse:hover {
    color: #ffffff;
    background: #2d3945;
}

/* ----- Level 1: Group headers (secondary / context) ------------------------ */
QWidget#SideBarGroup {
    background: transparent;
    margin-top: 6px;
}

QWidget#SideBarGroupHeader {
    background: #22262c;
    border: 1px solid #2c323a;
    border-radius: 5px;
    margin: 0px 6px;
    min-height: 32px;
    color: #c5cdd6;
}

QWidget#SideBarGroupHeader:hover {
    background: #2a3038;
    border-color: #3a4550;
}

/* Selected group: visible but muted — never competes with the active leaf */
QWidget#SideBarGroupHeader[selected="true"] {
    background: #1c2832;
    border: 1px solid #3a5568;
    border-left: 3px solid #4a7a9a;
    color: #c8d4de;
}

QWidget#SideBarGroupHeader[selected="true"]:hover {
    background: #223038;
    border-color: #4a6580;
    border-left-color: #5a8aaa;
}

QLabel#SideBarGroupTitle {
    color: #b8c4d0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QWidget#SideBarGroupHeader[selected="true"] QLabel#SideBarGroupTitle {
    color: #c5d4e0;
}

QLabel#SideBarGroupIndicator {
    color: #6a7a8a;
    font-size: 11px;
    font-weight: 700;
}

QWidget#SideBarGroupHeader[selected="true"] QLabel#SideBarGroupIndicator {
    color: #7a9ab0;
}

QWidget#SideBarGroupBody {
    background: transparent;
    margin: 2px 0px 4px 0px;
}

/* Nested leaves — dominant selection treatment */
QWidget#SideBarGroupBody QWidget#SideBarItem {
    margin-left: 10px;
    margin-right: 6px;
    border-radius: 4px;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    min-height: 30px;
    color: #a8b0b8;
    font-size: 12px;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[hover="true"] {
    background: #2a2e34;
    color: #e8ecf0;
    border-left-color: #5a6a7a;
}

/* Active leaf: strongest visual in the sidebar */
QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"] {
    background: #2a4558;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #3d6a88;
    border-left: 3px solid #75bdf5;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #315268;
    border-color: #4a7a9a;
    border-left-color: #9ad0ff;
}

/* ----- Level 2: Top-level leaf items --------------------------------------- */
QWidget#SideBarItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    margin: 1px 6px;
    min-height: 34px;
    color: #b0b8c0;
    font-size: 12.5px;
}

QWidget#SideBarItem[hover="true"] {
    background: #2a2e34;
    color: #f0f0f0;
    border-color: #3a4048;
}

QWidget#SideBarItem[selected="true"] {
    background: #2a4558;
    color: #ffffff;
    border: 1px solid #3d6a88;
    border-left: 3px solid #75bdf5;
    font-weight: 600;
}

QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #315268;
    border-color: #4a7a9a;
    border-left-color: #9ad0ff;
}

QLabel#SideBarText {
    color: inherit;
    background: transparent;
}

QLabel#SideBarIcon {
    background: transparent;
}

QFrame#SideBarSeparator {
    background: #2e2e2e;
    border: none;
    max-height: 1px;
    margin: 8px 12px;
}

QScrollArea#SideBarContent {
    background: transparent;
    border: none;
}

QWidget#SideBarContentContainer {
    background: transparent;
}
