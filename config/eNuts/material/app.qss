/* Live pipeline only — material */

QMainWindow,
QWidget {
    background-color: #fafafa;
    color: #212121;
}

QWidget#W_WORKSPACE {
    background-color: #fafafa;
    color: #212121;
}

QWidget#W_SIDEBAR {
    background-color: #eeeeee;
    color: #212121;
    border-right: 1px solid #e0e0e0;
}

QWidget#W_SIDEBAR[dockSide="right"] {
    border-right: 0px;
    border-left: 1px solid #e0e0e0;
}

QWidget#W_SIDEBAR QWidget#W_HEADER {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    color: #212121;
}

QLabel#SideBarHeaderTitle,
QLabel#W_SIDEBAR_TITLE {
    color: #212121;
    background: transparent;
}

QScrollArea#W_CONTENT,
QWidget#W_CONTENT_BODY {
    background-color: #eeeeee;
}

QWidget#W_DOCK_CONTROL {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
}

QWidget#W_SIDEBAR_ITEM {
    background-color: transparent;
    color: #616161;
    border-left: 2px solid transparent;
}

QWidget#W_SIDEBAR_ITEM:hover,
QWidget#W_SIDEBAR_ITEM[hover="true"] {
    background-color: #e0e0e0;
    color: #212121;
}

QWidget#W_SIDEBAR_ITEM[active="true"] {
    background-color: #c5cae9;
    color: #212121;
    border-left: 2px solid #3f51b5;
}

QWidget#W_SIDEBAR_ITEM[selected="true"] {
    background-color: #e8eaf6;
    color: #212121;
    border-left: 2px solid #3f51b5;
}

QWidget#W_SIDEBAR_GROUP_BODY {
    background-color: #f5f5f5;
}

QWidget#W_PAGE,
QWidget#DashboardPage,
QWidget#W_PAGE_CONTENT {
    background-color: #fafafa;
    color: #212121;
}

QWidget#W_PAGE_HEADER {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    color: #212121;
}

QLabel#W_HEADER_TITLE {
    color: #212121;
}

QLabel#W_HEADER_DESCRIPTION {
    color: #616161;
}

QWidget#DashboardGrid {
    background-color: #fafafa;
}

QFrame#Card {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #e0e0e0;
}

QFrame#Card:hover {
    border-color: #3f51b5;
}

QLabel#Card_Title {
    color: #212121;
}

QWidget#W_COMMANDBAR {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
}

QPushButton#C_COMMANDBAR_BUTTON {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #bdbdbd;
}
