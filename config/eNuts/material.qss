/* eNuts — material theme */

QMainWindow,
QWidget {
    background: #fafafa;
    color: #212121;
    font-family: "Roboto", "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
}

#SIDE_BAR {
    background: #ffffff;
    border-right: 1px solid #e0e0e0;
}

#BOTTOM_BAR {
    background: #ffffff;
    border-top: 1px solid #e0e0e0;
}

#SIDE_BAR QPushButton,
#BOTTOM_BAR QPushButton {
    background: transparent;
    color: #424242;
    border: 1px solid transparent;
    border-radius: 0px;
    padding: 7px 10px;
}

#SIDE_BAR QPushButton {
    text-align: left;
}

#BOTTOM_BAR QPushButton {
    background: #f5f5f5;
    border-color: #e0e0e0;
    color: #424242;
    padding: 5px 12px;
    text-align: center;
}

#SIDE_BAR QPushButton:hover,
#BOTTOM_BAR QPushButton:hover {
    background: #e8eaf6;
    color: #1a237e;
    border-color: #c5cae9;
}

#SIDE_BAR QPushButton:pressed,
#BOTTOM_BAR QPushButton:pressed {
    background: #c5cae9;
}

#SIDE_BAR QPushButton:checked {
    background: #e8eaf6;
    color: #1a237e;
    border-color: #3f51b5;
}

#SIDE_BAR QPushButton:checked:hover {
    background: #c5cae9;
}

#SIDE_BAR QPushButton:disabled,
#BOTTOM_BAR QPushButton:disabled {
    color: #9e9e9e;
    background: transparent;
    border-color: transparent;
}

#BOTTOM_BAR QPushButton:pressed {
    background: #3f51b5;
    border-color: #3f51b5;
    color: #ffffff;
}

QPushButton#CONTEXT_BACK { font-weight: 600; }
QPushButton#ADD_DEVICE { color: #3f51b5; }
QPushButton#ADD_DEVICE:hover { background: #e8eaf6; color: #1a237e; }

QListWidget { background: transparent; border: none; outline: none; padding: 4px 0; }
QListWidget::item { color: #424242; padding: 7px 10px; border-radius: 0px; }
QListWidget::item:hover { background: #e8eaf6; color: #1a237e; }
QListWidget::item:selected { background: #e8eaf6; color: #1a237e; }

QLabel#PAGE_TITLE { color: #212121; font-size: 20px; font-weight: 600; }
QLabel#WORKSPACE_DESCRIPTION { color: #757575; }
QLabel#WORKSPACE_SECTION_TITLE { color: #303f9f; font-size: 14px; font-weight: 600; }

QFrame#TRAINING_STAT_CARD,
QFrame#TRAINING_DEVICE_CARD { background: #ffffff; border: 1px solid #e0e0e0; border-radius: 0px; }
QFrame#TRAINING_STAT_CARD:hover,
QFrame#TRAINING_DEVICE_CARD:hover { border-color: #3f51b5; }

QLabel#TRAINING_STAT_VALUE { color: #212121; font-size: 22px; font-weight: 600; }
QLabel#TRAINING_STAT_LABEL { color: #757575; font-size: 10px; font-weight: 600; }
QLabel#TRAINING_DEVICE_NAME { color: #212121; font-size: 14px; font-weight: 600; }
QLabel#TRAINING_DEVICE_KIND { color: #757575; }
QLabel#TRAINING_DEVICE_STATUS { color: #3f51b5; font-size: 11px; }

/* 
    ==========================================================================
    SideBar hierarchy
    Group header = SideBarItem subclass → same selected/hover property path as leaves
    ==========================================================================
*/

QWidget#SideBar {
    background: #ffffff;
    border-right: 1px solid #e0e0e0;
}

QWidget#SideBarHeader {
    background: #f5f5f5;
    border: none;
    border-bottom: 2px solid #3f51b5;
    min-height: 40px;
    height: 40px;
    padding: 8px 0px;
}

QLabel#SideBarHeaderTitle {
    color: #212121;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#SideBarHeaderCollapse {
    background: transparent;
    border-radius: 0px;
    padding: 2px;
}

QLabel#SideBarHeaderCollapse:hover {
    background: #e8eaf6;
}

QWidget#SideBarGroup {
    background: transparent;
    margin-top: 8px;
}

/* Group header (SideBarItem-based) — secondary highlight vs dominant leaf */
QWidget#SideBarGroupHeader {
    background: #f0f2f8;
    border: 1px solid #e0e0e0;
    border-radius: 0px;
    margin: 2px 0px;
    min-height: 40px;
    color: #424242;
}

QWidget#SideBarGroupHeader[hover="true"] {
    background: #e8eaf6;
    border-color: #c5cae9;
}

QWidget#SideBarGroupHeader[selected="true"] {
    background-color: #e8eaf6;
    border: 1px solid #3f51b5;
    border-left: 3px solid #3f51b5;
    color: #1a237e;
}

QWidget#SideBarGroupHeader[selected="true"][hover="true"] {
    background-color: #c5cae9;
    border-color: #303f9f;
    border-left-color: #303f9f;
}

QWidget#SideBarGroupHeader QLabel {
    background: transparent;
    border: none;
}

QLabel#SideBarGroupTitle {
    color: #5c6bc0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    background: transparent;
}

QWidget#SideBarGroupHeader[selected="true"] QLabel#SideBarGroupTitle {
    color: #1a237e;
}

QLabel#SideBarGroupIndicator {
    background: transparent;
}

QWidget#SideBarGroupBody {
    background: transparent;
    margin: 3px 0px 6px 0px;
}

/* Nested children — deeper indent under group header */
QWidget#SideBarGroupBody QWidget#SideBarItem {
    margin-left: 40px;
    margin-right: 8px;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 0px;
    border: 1px solid transparent;
    border-left: 3px solid #e0e0e0;
    min-height: 26px;
    max-height: 28px;
    color: #616161;
    font-size: 11.5px;
    background: #fafafa;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[hover="true"] {
    background: #e8eaf6;
    color: #1a237e;
    border-left-color: #3f51b5;
    border-color: #c5cae9;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"] {
    background: #e8eaf6;
    color: #1a237e;
    font-weight: 600;
    border: 1px solid #3f51b5;
    border-left: 3px solid #3f51b5;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #c5cae9;
    border-color: #303f9f;
    border-left-color: #303f9f;
}

QWidget#SideBarItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    margin: 2px 6px;
    min-height: 32px;
    color: #424242;
    font-size: 12.5px;
}

QWidget#SideBarItem[hover="true"] {
    background: #e8eaf6;
    color: #1a237e;
    border-color: #c5cae9;
}

QWidget#SideBarItem[selected="true"] {
    background: #e8eaf6;
    color: #1a237e;
    border: 1px solid #3f51b5;
    border-left: 3px solid #3f51b5;
    font-weight: 600;
}

QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #c5cae9;
    border-color: #303f9f;
    border-left-color: #303f9f;
}

QLabel#SideBarText {
    color: inherit;
    background: transparent;
}

QLabel#SideBarIcon {
    background: transparent;
}

QFrame#SideBarSeparator {
    background: #e0e0e0;
    border: none;
    max-height: 1px;
    margin: 8px 12px;
}

QScrollArea#SideBarContent {
    background: transparent;
    border: none;
}

QWidget#SideBarContentContainer {
    background: transparent;
}
