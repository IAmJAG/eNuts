/* ==================================================================================
   material.qss
   ================================================================================== */

QMainWindow,
QWidget {
    background-color: #fafafa;
    color: #212121;
}

QMainWindow {
    background-color: #fafafa;
}

QWidget#W_COMMANDBAR {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
}

QPushButton#C_COMMANDBAR_BUTTON,
QPushButton {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #bdbdbd;
}

QPushButton#C_COMMANDBAR_BUTTON:hover,
QPushButton:hover {
    background-color: #eeeeee;
}

QPushButton#C_COMMANDBAR_BUTTON:pressed,
QPushButton:pressed {
    background-color: #e0e0e0;
}

QPushButton#C_COMMANDBAR_BUTTON:focus {
    border-color: #3f51b5;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #bdbdbd;
    selection-background-color: #c5cae9;
    selection-color: #212121;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #3f51b5;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #bdbdbd;
    selection-background-color: #c5cae9;
}

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
}

QTabBar::tab {
    background-color: #eeeeee;
    color: #616161;
    border: 1px solid #e0e0e0;
    padding: 7px 14px;
}

QTabBar::tab:hover {
    background-color: #e0e0e0;
    color: #212121;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #212121;
    border-bottom-color: #3f51b5;
}

QGroupBox {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #e0e0e0;
    margin-top: 10px;
    padding: 8px;
}

QListWidget,
QTreeWidget,
QTableWidget {
    background-color: #ffffff;
    color: #212121;
    alternate-background-color: #fafafa;
    border: 1px solid #e0e0e0;
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: #eeeeee;
}

QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: #c5cae9;
    color: #212121;
}

QMenu {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #bdbdbd;
}

QMenu::item:selected {
    background-color: #c5cae9;
    color: #212121;
}

QToolTip {
    background-color: #424242;
    color: #ffffff;
    border: 0px;
}

QWidget#SideBar {
    background-color: #eeeeee;
    border-right: 1px solid #e0e0e0;
}

QWidget#SideBarHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
}

QWidget#SideBarContent {
    background-color: #eeeeee;
}

QWidget#SideBarItem {
    background-color: transparent;
    color: #616161;
}

QWidget#SideBarItem:hover {
    background-color: #e0e0e0;
    color: #212121;
}

QWidget#SideBarItemSelected,
QFrame#SideBarGroupHeaderSelected {
    background-color: #c5cae9;
    color: #212121;
}

QFrame#SideBarGroupHeader {
    background-color: transparent;
    color: #616161;
}

QFrame#SideBarGroupHeader:hover {
    background-color: #e0e0e0;
    color: #212121;
}

QWidget#SideBarGroupBody {
    background-color: #f5f5f5;
}

QLabel#SideBarText,
QLabel#SideBarGroupTitle {
    color: inherit;
}


