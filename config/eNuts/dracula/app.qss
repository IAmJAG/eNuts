/* Live pipeline only — dracula */

QMainWindow,
QWidget {
    background-color: #282a36;
    color: #f8f8f2;
}

QWidget#W_WORKSPACE {
    background-color: #282a36;
    color: #f8f8f2;
}

QWidget#W_SIDEBAR {
    background-color: #21222c;
    color: #f8f8f2;
    border-right: 1px solid #44475a;
}

QWidget#W_SIDEBAR[dockSide="right"] {
    border-right: 0px;
    border-left: 1px solid #44475a;
}

QWidget#W_SIDEBAR QWidget#W_HEADER {
    background-color: #191a21;
    border-bottom: 1px solid #44475a;
    color: #f8f8f2;
}

QLabel#SideBarHeaderTitle,
QLabel#W_SIDEBAR_TITLE {
    color: #f8f8f2;
    background: transparent;
}

QScrollArea#W_CONTENT,
QWidget#W_CONTENT_BODY {
    background-color: #21222c;
}

QWidget#W_DOCK_CONTROL {
    background-color: #191a21;
    border-top: 1px solid #44475a;
}

QWidget#W_SIDEBAR_ITEM {
    background-color: transparent;
    color: #bdc0c9;
    border-left: 2px solid transparent;
}

QWidget#W_SIDEBAR_ITEM:hover,
QWidget#W_SIDEBAR_ITEM[hover="true"] {
    background-color: #44475a;
    color: #ffffff;
}

QWidget#W_SIDEBAR_ITEM[active="true"] {
    background-color: #6272a4;
    color: #ffffff;
    border-left: 2px solid #bd93f9;
}

QWidget#W_SIDEBAR_ITEM[selected="true"] {
    background-color: #44475a;
    color: #ffffff;
    border-left: 2px solid #bd93f9;
}

QWidget#W_SIDEBAR_GROUP_BODY {
    background-color: #282a36;
}

QWidget#W_PAGE,
QWidget#DashboardPage,
QWidget#W_PAGE_CONTENT {
    background-color: #282a36;
    color: #f8f8f2;
}

QWidget#W_PAGE_HEADER {
    background-color: #21222c;
    border-bottom: 1px solid #44475a;
    color: #f8f8f2;
}

QLabel#W_HEADER_TITLE {
    color: #f8f8f2;
}

QLabel#W_HEADER_DESCRIPTION {
    color: #6272a4;
}

QWidget#DashboardGrid {
    background-color: #282a36;
}

QFrame#Card {
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #44475a;
}

QFrame#Card:hover {
    border-color: #bd93f9;
}

QLabel#Card_Title {
    color: #f8f8f2;
}

QWidget#W_COMMANDBAR {
    background-color: #21222c;
    border-top: 1px solid #44475a;
}

QPushButton#C_COMMANDBAR_BUTTON {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid #6272a4;
}
