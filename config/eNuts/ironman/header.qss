/* ==================================================================================
   Page Header — Ironman
   ================================================================================== */

QWidget#W_PAGE_HEADER {
    background-color: #12161c;
    color: #f5f7fa;
    border-bottom: 1px solid #3a4250;
}

QLabel#W_HEADER_TITLE {
    color: #ffffff;
    font-weight: 600;
    font-size: 15px;
    background: transparent;
}

QLabel#W_HEADER_DESCRIPTION {
    color: #aeb6c0;
    font-size: 11px;
    font-weight: 400;
    background: transparent;
}

QWidget#W_HEADER_ICON {
    background: transparent;
}

QWidget#W_HEADER_TEXT,
QWidget#W_HEADER_TITLE_ROW,
QWidget#W_HEADER_SPAN_ROW,
QWidget#W_HEADER_DESC_HOST {
    background: transparent;
    color: #f5f7fa;
    border: 0px;
}
