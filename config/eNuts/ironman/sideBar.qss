/* ==================================================================================
   SideBar — Ironman
   Live names: W_SIDEBAR, W_HEADER (scoped), W_CONTENT, W_SIDEBAR_ITEM,
   W_GROUP, W_SIDEBAR_GROUP_BODY, W_DOCK_CONTROL, W_SIDEBAR_TITLE
   ================================================================================== */

QWidget#W_SIDEBAR {
    background-color: #141820;
    border-right: 1px solid #3a4250;
    color: #f5f7fa;
}

QWidget#W_SIDEBAR[dockSide="right"] {
    border-right: 0px;
    border-left: 1px solid #3a4250;
}

/* SideBar header host (OBJECT_NAME = W_HEADER, under W_SIDEBAR) */
QWidget#W_SIDEBAR QWidget#W_HEADER {
    background-color: #1a2029;
    border-bottom: 1px solid #3a4250;
    min-height: 44px;
    color: #ffffff;
}

QLabel#SideBarHeaderTitle,
QWidget#W_SIDEBAR QLabel#W_SIDEBAR_TITLE {
    color: #ffffff;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
}

QScrollArea#W_CONTENT,
QWidget#W_CONTENT_BODY {
    background-color: #141820;
    color: #f5f7fa;
    border: 0px;
}

QWidget#W_DOCK_CONTROL {
    background-color: #1a2029;
    border-top: 1px solid #3a4250;
    min-height: 28px;
    max-height: 28px;
    color: #f5f7fa;
}

/* --- items / group headers (both are W_SIDEBAR_ITEM) --- */
QWidget#W_SIDEBAR_ITEM {
    background-color: transparent;
    color: #e8edf5;
    border: 0px;
    border-left: 2px solid transparent;
    padding: 2px 4px;
    min-height: 28px;
}

QWidget#W_SIDEBAR_ITEM:hover,
QWidget#W_SIDEBAR_ITEM[hover="true"] {
    background-color: #252c38;
    color: #ffffff;
}

QWidget#W_SIDEBAR_ITEM[depth="0"] {
    font-size: 13px;
    font-weight: 600;
    min-height: 30px;
    color: #f5f7fa;
}

QWidget#W_SIDEBAR_ITEM[depth="1"] {
    font-size: 12px;
    font-weight: 400;
    min-height: 26px;
    padding-left: 8px;
    color: #dce3ee;
}

QWidget#W_SIDEBAR_ITEM[depth="2"] {
    font-size: 11px;
    font-weight: 400;
    min-height: 24px;
    padding-left: 14px;
    color: #c8d0dc;
}

QWidget#W_SIDEBAR_ITEM[selected="true"] {
    background-color: #4a1c20;
    color: #ffe8e8;
    border-left: 2px solid #e53935;
}

QWidget#W_SIDEBAR_ITEM[selected="true"][depth="0"] {
    background-color: #3a1619;
    color: #ffd6d6;
    border-left-color: #c62828;
}

QWidget#W_SIDEBAR_ITEM[active="true"] {
    background-color: #b71c1c;
    color: #ffffff;
    border-left: 2px solid #ffca28;
}

QWidget#W_SIDEBAR_ITEM[active="true"]:hover {
    background-color: #c62828;
    color: #ffffff;
}

QWidget#W_SIDEBAR_ITEM[role="header"] {
    color: #f0f4fa;
}

QWidget#W_GROUP {
    background-color: transparent;
    color: #f5f7fa;
}

QWidget#W_SIDEBAR_GROUP_BODY {
    background-color: #10141a;
}

/* Labels — set color directly */
QLabel#W_SIDEBAR_TITLE {
    color: #e8edf5;
    background: transparent;
}

QWidget#W_SIDEBAR_ITEM[depth="0"] QLabel#W_SIDEBAR_TITLE {
    color: #f5f7fa;
}

QWidget#W_SIDEBAR_ITEM[depth="1"] QLabel#W_SIDEBAR_TITLE {
    color: #dce3ee;
}

QWidget#W_SIDEBAR_ITEM[depth="2"] QLabel#W_SIDEBAR_TITLE {
    color: #c8d0dc;
}

QWidget#W_SIDEBAR_ITEM[active="true"] QLabel#W_SIDEBAR_TITLE {
    color: #ffffff;
}

QWidget#W_SIDEBAR_ITEM[selected="true"] QLabel#W_SIDEBAR_TITLE {
    color: #ffe8e8;
}

QWidget#W_SIDEBAR_ITEM[hover="true"] QLabel#W_SIDEBAR_TITLE {
    color: #ffffff;
}
