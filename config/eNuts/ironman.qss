/* eNuts — ironman theme (high contrast)
 * Black-on-dark is Qt system WindowText leaking through; force light FG on
 * QLabel, QGroupBox, tabs, and form controls — not only QWidget.
 */

QMainWindow,
QWidget {
    background-color: #0e1014;
    color: #f5f7fa;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
}

QLabel {
    color: #f5f7fa;
    background: transparent;
}

QGroupBox {
    color: #f5f7fa;
    border: 1px solid #3d4652;
    border-radius: 0px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #161a20;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #f0c14b;
}

QTabWidget::pane {
    border: 1px solid #3d4652;
    background: #12161c;
    top: -1px;
}

QTabBar::tab {
    background: #1e242c;
    color: #e0e6ec;
    border: 1px solid #3d4652;
    padding: 8px 16px;
    margin-right: 2px;
    border-radius: 0px;
}

QTabBar::tab:selected {
    background: #4a1518;
    color: #ffffff;
    border-color: #e31b23;
    border-bottom-color: #4a1518;
}

QTabBar::tab:hover:!selected {
    background: #2a323c;
    color: #ffffff;
}

QComboBox,
QLineEdit,
QSpinBox {
    background-color: #1e242c;
    color: #f5f7fa;
    border: 1px solid #3d4652;
    border-radius: 0px;
    padding: 6px 8px;
    selection-background-color: #e31b23;
    selection-color: #ffffff;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover {
    border-color: #f0c14b;
}

QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus {
    border-color: #5ce1ff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #f5f7fa;
}

QComboBox QAbstractItemView {
    background-color: #1e242c;
    color: #f5f7fa;
    border: 1px solid #3d4652;
    selection-background-color: #e31b23;
    selection-color: #ffffff;
}

QAbstractItemView {
    background-color: #161a20;
    color: #f5f7fa;
    selection-background-color: #4a1518;
    selection-color: #ffffff;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background: #1e242c;
    border: 1px solid #3d4652;
}

QToolTip {
    background-color: #1e242c;
    color: #f5f7fa;
    border: 1px solid #f0c14b;
}

QPushButton#CONTEXT_BACK { font-weight: 600; }
QPushButton#ADD_DEVICE { color: #5ce1ff; }
QPushButton#ADD_DEVICE:hover { background: #1a2830; color: #ffffff; }

QListWidget { background: transparent; border: none; outline: none; padding: 4px 0; }
QListWidget::item { color: #e0e6ec; padding: 7px 10px; border-radius: 0px; }
QListWidget::item:hover { background: #2a323c; color: #ffffff; }
QListWidget::item:selected { background: #4a1518; color: #ffffff; }

QLabel#PAGE_TITLE {
    color: #ffffff;
    font-size: 20px;
    font-weight: 600;
}
QLabel#WORKSPACE_DESCRIPTION { color: #aeb6c0; }
QLabel#WORKSPACE_SECTION_TITLE { color: #f0c14b; font-size: 14px; font-weight: 600; }

QFrame#TRAINING_STAT_CARD,
QFrame#TRAINING_DEVICE_CARD { background: #161a20; border: 1px solid #3d4652; border-radius: 0px; }
QFrame#TRAINING_STAT_CARD:hover,
QFrame#TRAINING_DEVICE_CARD:hover { border-color: #f0c14b; }

QLabel#TRAINING_STAT_VALUE { color: #ffffff; font-size: 22px; font-weight: 600; }
QLabel#TRAINING_STAT_LABEL { color: #aeb6c0; font-size: 10px; font-weight: 600; }
QLabel#TRAINING_DEVICE_NAME { color: #f5f7fa; font-size: 14px; font-weight: 600; }
QLabel#TRAINING_DEVICE_KIND { color: #aeb6c0; }
QLabel#TRAINING_DEVICE_STATUS { color: #5ce1ff; font-size: 11px; }

QWidget#SideBar {
    background: #161a20;
    border-right: 1px solid #c41e26;
}

QWidget#SideBarHeader {
    background: #0a0c0f;
    border: none;
    border-bottom: 2px solid #e31b23;
    min-height: 40px;
    height: 40px;
    padding: 8px 0px;
}

QLabel#SideBarHeaderTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#SideBarHeaderCollapse {
    background: transparent;
    border-radius: 0px;
    padding: 2px;
}

QLabel#SideBarHeaderCollapse:hover {
    background: #4a1518;
}

QWidget#SideBarGroup {
    background: transparent;
    margin-top: 8px;
}

QWidget#SideBarGroupHeader {
    background: #1c222a;
    border: 1px solid #3d4652;
    border-radius: 0px;
    margin: 2px 0px;
    min-height: 40px;
    color: #e8edf2;
}

QWidget#SideBarGroupHeader[hover="true"] {
    background: #2a323c;
    border-color: #f0c14b;
}

QWidget#SideBarGroupHeader[selected="true"] {
    background-color: #4a1518;
    border: 1px solid #e31b23;
    border-left: 3px solid #f0c14b;
    color: #ffffff;
}

QWidget#SideBarGroupHeader[selected="true"][hover="true"] {
    background-color: #5c181c;
    border-color: #ff2d35;
    border-left-color: #ffd666;
}

QLabel#SideBarGroupTitle {
    color: #f0c14b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    background: transparent;
}

QWidget#SideBarGroupHeader[selected="true"] QLabel#SideBarGroupTitle {
    color: #ffffff;
}

QWidget#SideBarGroupBody {
    background: transparent;
    margin: 3px 0px 6px 0px;
}

QWidget#SideBarGroupBody QWidget#SideBarItem {
    margin-left: 40px;
    margin-right: 8px;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 0px;
    border: 1px solid transparent;
    border-left: 3px solid #3d4652;
    min-height: 26px;
    max-height: 28px;
    color: #d8dee6;
    font-size: 11.5px;
    background: #12161c;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[hover="true"] {
    background: #2a323c;
    color: #ffffff;
    border-left-color: #5ce1ff;
    border-color: #4a5560;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"] {
    background: #4a1518;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #e31b23;
    border-left: 3px solid #f0c14b;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #5c181c;
    border-color: #ff2d35;
    border-left-color: #ffd666;
}

QWidget#SideBarItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    margin: 2px 6px;
    min-height: 32px;
    color: #e8edf2;
    font-size: 12.5px;
}

QWidget#SideBarItem[hover="true"] {
    background: #2a323c;
    color: #ffffff;
    border-color: #f0c14b;
}

QWidget#SideBarItem[selected="true"] {
    background: #4a1518;
    color: #ffffff;
    border: 1px solid #e31b23;
    border-left: 3px solid #f0c14b;
    font-weight: 600;
}

QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #5c181c;
    border-color: #ff2d35;
    border-left-color: #ffd666;
}

QFrame#SideBarSeparator {
    background: #c41e26;
    border: none;
    max-height: 1px;
    margin: 8px 12px;
}

QScrollArea#SideBarContent {
    background: transparent;
    border: none;
}

QWidget#SideBarContentContainer {
    background: transparent;
}
