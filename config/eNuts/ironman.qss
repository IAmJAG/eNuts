/* eNuts — ironman theme (high contrast) */

QMainWindow,
QWidget {
    background: #0e1014;
    color: #f5f7fa;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
}

#SIDE_BAR {
    background: #161a20;
    border-right: 1px solid #c41e26;
}

#BOTTOM_BAR {
    background: #161a20;
    border-top: 1px solid #c41e26;
}

#SIDE_BAR QPushButton,
#BOTTOM_BAR QPushButton {
    background: transparent;
    color: #f0c14b;
    border: 1px solid transparent;
    border-radius: 0px;
    padding: 7px 10px;
}

#SIDE_BAR QPushButton {
    text-align: left;
}

#BOTTOM_BAR QPushButton {
    background: #1e242c;
    border-color: #3d4652;
    color: #f5f7fa;
    padding: 5px 12px;
    text-align: center;
}

#SIDE_BAR QPushButton:hover,
#BOTTOM_BAR QPushButton:hover {
    background: #2a323c;
    color: #ffffff;
    border-color: #f0c14b;
}

#SIDE_BAR QPushButton:pressed,
#BOTTOM_BAR QPushButton:pressed {
    background: #5c181c;
}

#SIDE_BAR QPushButton:checked {
    background: #4a1518;
    color: #ffffff;
    border-color: #e31b23;
}

#SIDE_BAR QPushButton:checked:hover {
    background: #5c181c;
}

#SIDE_BAR QPushButton:disabled,
#BOTTOM_BAR QPushButton:disabled {
    color: #6a727c;
    background: transparent;
    border-color: transparent;
}

#BOTTOM_BAR QPushButton:pressed {
    background: #e31b23;
    border-color: #f0c14b;
    color: #ffffff;
}

QPushButton#CONTEXT_BACK { font-weight: 600; }
QPushButton#ADD_DEVICE { color: #5ce1ff; }
QPushButton#ADD_DEVICE:hover { background: #1a2830; color: #ffffff; }

QListWidget { background: transparent; border: none; outline: none; padding: 4px 0; }
QListWidget::item { color: #e0e6ec; padding: 7px 10px; border-radius: 0px; }
QListWidget::item:hover { background: #2a323c; color: #ffffff; }
QListWidget::item:selected { background: #4a1518; color: #ffffff; }

QLabel#PAGE_TITLE {
    color: #ffffff;
    font-size: 20px;
    font-weight: 600;
}
QLabel#WORKSPACE_DESCRIPTION { color: #aeb6c0; }
QLabel#WORKSPACE_SECTION_TITLE { color: #f0c14b; font-size: 14px; font-weight: 600; }

QFrame#TRAINING_STAT_CARD,
QFrame#TRAINING_DEVICE_CARD { background: #161a20; border: 1px solid #3d4652; border-radius: 0px; }
QFrame#TRAINING_STAT_CARD:hover,
QFrame#TRAINING_DEVICE_CARD:hover { border-color: #f0c14b; }

QLabel#TRAINING_STAT_VALUE { color: #ffffff; font-size: 22px; font-weight: 600; }
QLabel#TRAINING_STAT_LABEL { color: #aeb6c0; font-size: 10px; font-weight: 600; }
QLabel#TRAINING_DEVICE_NAME { color: #f5f7fa; font-size: 14px; font-weight: 600; }
QLabel#TRAINING_DEVICE_KIND { color: #aeb6c0; }
QLabel#TRAINING_DEVICE_STATUS { color: #5ce1ff; font-size: 11px; }

/* 
    ==========================================================================
    SideBar hierarchy
    Group header = SideBarItem subclass → same selected/hover property path as leaves
    ==========================================================================
*/

QWidget#SideBar {
    background: #161a20;
    border-right: 1px solid #c41e26;
}

QWidget#SideBarHeader {
    background: #0a0c0f;
    border: none;
    border-bottom: 2px solid #e31b23;
    min-height: 40px;
    height: 40px;
    padding: 8px 0px;
}

QLabel#SideBarHeaderTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#SideBarHeaderCollapse {
    background: transparent;
    border-radius: 0px;
    padding: 2px;
}

QLabel#SideBarHeaderCollapse:hover {
    background: #4a1518;
}

QWidget#SideBarGroup {
    background: transparent;
    margin-top: 8px;
}

/* Group header (SideBarItem-based) — secondary highlight vs dominant leaf */
QWidget#SideBarGroupHeader {
    background: #1c222a;
    border: 1px solid #3d4652;
    border-radius: 0px;
    margin: 2px 0px;
    min-height: 40px;
    color: #e8edf2;
}

QWidget#SideBarGroupHeader[hover="true"] {
    background: #2a323c;
    border-color: #f0c14b;
}

QWidget#SideBarGroupHeader[selected="true"] {
    background-color: #4a1518;
    border: 1px solid #e31b23;
    border-left: 3px solid #f0c14b;
    color: #ffffff;
}

QWidget#SideBarGroupHeader[selected="true"][hover="true"] {
    background-color: #5c181c;
    border-color: #ff2d35;
    border-left-color: #ffd666;
}

QWidget#SideBarGroupHeader QLabel {
    background: transparent;
    border: none;
}

QLabel#SideBarGroupTitle {
    color: #f0c14b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    background: transparent;
}

QWidget#SideBarGroupHeader[selected="true"] QLabel#SideBarGroupTitle {
    color: #ffffff;
}

QLabel#SideBarGroupIndicator {
    background: transparent;
}

QWidget#SideBarGroupBody {
    background: transparent;
    margin: 3px 0px 6px 0px;
}

/* Nested children — deeper indent under group header */
QWidget#SideBarGroupBody QWidget#SideBarItem {
    margin-left: 40px;
    margin-right: 8px;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 0px;
    border: 1px solid transparent;
    border-left: 3px solid #3d4652;
    min-height: 26px;
    max-height: 28px;
    color: #d8dee6;
    font-size: 11.5px;
    background: #12161c;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[hover="true"] {
    background: #2a323c;
    color: #ffffff;
    border-left-color: #5ce1ff;
    border-color: #4a5560;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"] {
    background: #4a1518;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #e31b23;
    border-left: 3px solid #f0c14b;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #5c181c;
    border-color: #ff2d35;
    border-left-color: #ffd666;
}

QWidget#SideBarItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    margin: 2px 6px;
    min-height: 32px;
    color: #e8edf2;
    font-size: 12.5px;
}

QWidget#SideBarItem[hover="true"] {
    background: #2a323c;
    color: #ffffff;
    border-color: #f0c14b;
}

QWidget#SideBarItem[selected="true"] {
    background: #4a1518;
    color: #ffffff;
    border: 1px solid #e31b23;
    border-left: 3px solid #f0c14b;
    font-weight: 600;
}

QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #5c181c;
    border-color: #ff2d35;
    border-left-color: #ffd666;
}

QLabel#SideBarText {
    color: inherit;
    background: transparent;
}

QLabel#SideBarIcon {
    background: transparent;
}

QFrame#SideBarSeparator {
    background: #c41e26;
    border: none;
    max-height: 1px;
    margin: 8px 12px;
}

QScrollArea#SideBarContent {
    background: transparent;
    border: none;
}

QWidget#SideBarContentContainer {
    background: transparent;
}
