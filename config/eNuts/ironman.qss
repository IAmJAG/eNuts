/* eNuts — ironman theme */

QMainWindow,
QWidget {
    background: #17191d;
    color: #e7e9ec;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
}

#SIDE_BAR {
    background: #20242a;
    border-right: 1px solid #8b1e24;
}

#BOTTOM_BAR {
    background: #20242a;
    border-top: 1px solid #8b1e24;
}

#SIDE_BAR QPushButton,
#BOTTOM_BAR QPushButton {
    background: transparent;
    color: #c8a951;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 7px 10px;
}

#SIDE_BAR QPushButton {
    text-align: left;
}

#BOTTOM_BAR QPushButton {
    background: #292e35;
    border-color: #4a5058;
    color: #e7e9ec;
    padding: 5px 12px;
    text-align: center;
}

#SIDE_BAR QPushButton:hover,
#BOTTOM_BAR QPushButton:hover {
    background: #343a43;
    color: #ffffff;
    border-color: #c8a951;
}

#SIDE_BAR QPushButton:pressed,
#BOTTOM_BAR QPushButton:pressed {
    background: #7a151b;
}

#SIDE_BAR QPushButton:checked {
    background: #3a2024;
    color: #ffffff;
    border-color: #a51d25;
}

#SIDE_BAR QPushButton:checked:hover {
    background: #4a282c;
}

#SIDE_BAR QPushButton:disabled,
#BOTTOM_BAR QPushButton:disabled {
    color: #5a6068;
    background: transparent;
    border-color: transparent;
}

#BOTTOM_BAR QPushButton:pressed {
    background: #a51d25;
    border-color: #d4af37;
    color: #ffffff;
}

QPushButton#CONTEXT_BACK { font-weight: 600; }
QPushButton#ADD_DEVICE { color: #56d9ff; }
QPushButton#ADD_DEVICE:hover { background: #2a3540; color: #ffffff; }

QListWidget { background: transparent; border: none; outline: none; padding: 4px 0; }
QListWidget::item { color: #c8cdd2; padding: 7px 10px; border-radius: 4px; }
QListWidget::item:hover { background: #343a43; color: #ffffff; }
QListWidget::item:selected { background: #3a2024; color: #ffffff; }

QLabel#PAGE_TITLE { color: #f0f0f0; font-size: 20px; font-weight: 600; }
QLabel#WORKSPACE_DESCRIPTION { color: #8a9098; }
QLabel#WORKSPACE_SECTION_TITLE { color: #d4af37; font-size: 14px; font-weight: 600; }

QFrame#TRAINING_STAT_CARD,
QFrame#TRAINING_DEVICE_CARD { background: #20242a; border: 1px solid #4a5058; border-radius: 6px; }
QFrame#TRAINING_STAT_CARD:hover,
QFrame#TRAINING_DEVICE_CARD:hover { border-color: #d4af37; }

QLabel#TRAINING_STAT_VALUE { color: #f0f0f0; font-size: 22px; font-weight: 600; }
QLabel#TRAINING_STAT_LABEL { color: #8a9098; font-size: 10px; font-weight: 600; }
QLabel#TRAINING_DEVICE_NAME { color: #e7e9ec; font-size: 14px; font-weight: 600; }
QLabel#TRAINING_DEVICE_KIND { color: #8a9098; }
QLabel#TRAINING_DEVICE_STATUS { color: #56d9ff; font-size: 11px; }

/* ==========================================================================
   SideBar hierarchy
   Group header = SideBarItem subclass → same selected/hover property path as leaves
   ========================================================================== */

QWidget#SideBar {
    background: #20242a;
    border-right: 1px solid #8b1e24;
}

QWidget#SideBarHeader {
    background: #1a1d22;
    border: none;
    border-bottom: 2px solid #a51d25;
    min-height: 52px;
    padding: 8px 0px;
}

QLabel#SideBarHeaderTitle {
    color: #e7e9ec;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#SideBarHeaderCollapse {
    background: transparent;
    border-radius: 4px;
    padding: 2px;
}

QLabel#SideBarHeaderCollapse:hover {
    background: #3a2024;
}

QWidget#SideBarGroup {
    background: transparent;
    margin-top: 8px;
}

/* Group header (SideBarItem-based) — secondary highlight vs dominant leaf */
QWidget#SideBarGroupHeader {
    background-color: #262b32;
    border: 1px solid #3a4048;
    border-radius: 6px;
    margin: 2px 6px;
    min-height: 40px;
    color: #c8cdd2;
}

QWidget#SideBarGroupHeader[hover="true"] {
    background-color: #30363e;
    border-color: #c8a951;
}

QWidget#SideBarGroupHeader[selected="true"] {
    background-color: #3a2024;
    border: 1px solid #a51d25;
    border-left: 3px solid #d4af37;
    color: #ffffff;
}

QWidget#SideBarGroupHeader[selected="true"][hover="true"] {
    background-color: #4a282c;
    border-color: #c52a32;
    border-left-color: #e0c050;
}

QWidget#SideBarGroupHeader QLabel {
    background: transparent;
    border: none;
}

QLabel#SideBarGroupTitle {
    color: #c8a951;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    background: transparent;
}

QWidget#SideBarGroupHeader[selected="true"] QLabel#SideBarGroupTitle {
    color: #ffffff;
}

QLabel#SideBarGroupIndicator {
    background: transparent;
}

QWidget#SideBarGroupBody {
    background: transparent;
    margin: 3px 0px 6px 0px;
}

/* Nested children — deeper indent under group header */
QWidget#SideBarGroupBody QWidget#SideBarItem {
    margin-left: 40px;
    margin-right: 8px;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 4px;
    border: 1px solid transparent;
    border-left: 3px solid #3a4048;
    min-height: 26px;
    max-height: 28px;
    color: #a8b0b8;
    font-size: 11.5px;
    background: #1c2026;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[hover="true"] {
    background: #30363e;
    color: #ffffff;
    border-left-color: #56d9ff;
    border-color: #4a5058;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"] {
    background: #3a2024;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #a51d25;
    border-left: 3px solid #d4af37;
}

QWidget#SideBarGroupBody QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #4a282c;
    border-color: #c52a32;
    border-left-color: #e0c050;
}

QWidget#SideBarItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    margin: 2px 6px;
    min-height: 32px;
    color: #c8cdd2;
    font-size: 12.5px;
}

QWidget#SideBarItem[hover="true"] {
    background: #343a43;
    color: #ffffff;
    border-color: #c8a951;
}

QWidget#SideBarItem[selected="true"] {
    background: #3a2024;
    color: #ffffff;
    border: 1px solid #a51d25;
    border-left: 3px solid #d4af37;
    font-weight: 600;
}

QWidget#SideBarItem[selected="true"][hover="true"] {
    background: #4a282c;
    border-color: #c52a32;
    border-left-color: #e0c050;
}

QLabel#SideBarText {
    color: inherit;
    background: transparent;
}

QLabel#SideBarIcon {
    background: transparent;
}

QFrame#SideBarSeparator {
    background: #8b1e24;
    border: none;
    max-height: 1px;
    margin: 8px 12px;
}

QScrollArea#SideBarContent {
    background: transparent;
    border: none;
}

QWidget#SideBarContentContainer {
    background: transparent;
}
